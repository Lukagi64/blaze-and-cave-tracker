# Template — Copier vers .env et adapter selon l'environnement
# NE PAS COMMITTER .env (dans .gitignore)

# Environnement : development | preproduction | production
ENV_NAME=development

# Port interne/extérieur (même valeur des deux côtés)
PORT=3000

# Base de données (fichier SQLite dans ./data/)
DB_PATH=./data/database.sqlite

# Token API secret (générer un unique par environnement)
# openssl rand -hex 32
API_SECRET_TOKEN=changeme-dev-secret-token

# Twitch (optionnel)
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret